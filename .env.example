NUXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NUXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-or-anon-key
# Solo/dev inspector (local only — UI hidden in production builds)
NUXT_PUBLIC_DEV_INSPECTOR_KEY=penpass-local-dev

# Resend (server-only) — https://resend.com/api-keys
RESEND_API_KEY=
# Production: use a verified domain. Testing: DoodleLoop <onboarding@resend.dev>
RESEND_FROM_EMAIL=DoodleLoop <onboarding@resend.dev>
